# Configurazione di sviluppo. In produzione questi valori arrivano
# dall'ambiente del container, non da un file nel repository.
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=tarots
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=tarot-frontend
# `true` salta Keycloak: il backend deve girare con TAROT_AUTH_DISABLED=true.
NEXT_PUBLIC_AUTH_DISABLED=false
# Estensione delle carte in public/cards/: `webp` per le immagini definitive
# (9:16, nome `{id}.webp` e `dorso.webp`), `svg` per i segnaposto di `npm run carte`.
NEXT_PUBLIC_CARD_EXT=webp
# Il sito che compare nei link condivisi e sulle immagini dei post. In produzione
# è https://tarots.chat; per provare i link in locale: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tarots.chat
# Come il server di Next raggiunge l'API per scrivere le anteprime dei social
# (Open Graph). Senza, usa NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:8100
