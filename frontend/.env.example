# Configurazione di sviluppo. In produzione questi valori arrivano
# dall'ambiente del container, non da un file nel repository.
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=tarots
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=tarot-frontend
# `true` salta Keycloak: il backend deve girare con TAROT_AUTH_DISABLED=true.
NEXT_PUBLIC_AUTH_DISABLED=false
# Estensione delle facce in public/cards/: `svg` per i segnaposto generati
# (`npm run carte`), `webp` quando arrivano le immagini definitive.
NEXT_PUBLIC_CARD_EXT=svg
