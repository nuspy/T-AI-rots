# Configurazione di sviluppo del backend (prefisso TAROT_). In produzione i
# valori arrivano dall'ambiente del container, non da un file.

TAROT_DATABASE_URL=postgresql+psycopg://tarot:tarot@localhost:5433/tarot
TAROT_KEYCLOAK_URL=http://localhost:8080
TAROT_KEYCLOAK_REALM=tarots

# Sviluppo senza Keycloak: ogni richiesta è dell'utente di sviluppo (admin).
TAROT_AUTH_DISABLED=false

# --- i modelli -------------------------------------------------------------
# Un modello solo per tutti i compiti:
TAROT_LLM_PROVIDER=anthropic
TAROT_ANTHROPIC_API_KEY=
TAROT_ANTHROPIC_MODEL=claude-sonnet-5
# oppure un server OpenAI-compatibile (OpenAI, LM Studio, vLLM, llama.cpp):
# TAROT_LLM_PROVIDER=openai-compatible
# TAROT_LLM_BASE_URL=http://127.0.0.1:1234/v1
# TAROT_LLM_MODEL=
# TAROT_LLM_API_KEY=

# Oppure un elenco di modelli, da assegnare ai compiti dalla console
# (intervista, validazione, interpretazione, sintesi, giudizio):
# TAROT_MODELLI=[{"nome":"sonnet","provider":"anthropic","model":"claude-sonnet-5","api_key":"..."},{"nome":"haiku","provider":"anthropic","model":"claude-haiku-4-5-20251001","api_key":"..."}]

# Il modello finto: prova tutto il flusso senza un modello vero.
TAROT_LLM_FINTO=false

# --- pagamenti --------------------------------------------------------------
# `mock`: il checkout simulato. In produzione `disattivato` finché non c'è un
# fornitore vero (l'avvio rifiuta `mock` in produzione).
TAROT_BILLING_PROVIDER=mock
TAROT_BILLING_WEBHOOK_SECRET=segreto-di-sviluppo-da-cambiare
TAROT_API_PUBLIC_URL=http://localhost:8100
TAROT_WEB_PUBLIC_URL=http://localhost:3000

# --- letture ---------------------------------------------------------------
TAROT_INTERVISTA_MAX_DOMANDE=5
TAROT_CREDITI_UTENTE_DI_PROVA=1000
TAROT_CREDITI_INVITO=3
