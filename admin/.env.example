# Dove risponde il backend FastAPI.
NEXT_PUBLIC_API_URL=http://localhost:8100

# Keycloak: realm e client pubblico della console (PKCE).
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=tarots
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=tarot-admin

# Solo sviluppo: `true` salta Keycloak e manda le richieste senza token.
# Va in coppia con TAROT_AUTH_DISABLED=true nel backend, il cui utente di
# sviluppo porta il ruolo admin.
NEXT_PUBLIC_AUTH_DISABLED=false
